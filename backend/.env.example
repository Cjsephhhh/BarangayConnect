# Set this to the JDBC connection string from Supabase > Connect > Session pooler > JDBC.
# Keep the real value private. This example is not loaded automatically by Spring Boot.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?user=postgres.YOUR_PROJECT_REF&password=YOUR_DATABASE_PASSWORD&sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@barangayconnect.local
BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-strong-password
BOOTSTRAP_ADMIN_NAME=BarangayConnect Administrator
BOOTSTRAP_ADMIN_MOBILE=09999999999

# SMTP settings for Increment 2 password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-verified-domain.com
FRONTEND_URL=http://localhost:5173
